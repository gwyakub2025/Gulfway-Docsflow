rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened primitive helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'superadmin@gulfway.ae'
      );
    }

    function isValidDocumentRecord(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.formTemplateId is string && data.formTemplateId.size() <= 128 &&
             data.companyId is string && data.companyId.size() <= 128 &&
             data.status is string && data.status.size() <= 32 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidAuditLog(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.action is string && data.action.size() <= 150 &&
             data.resourceType is string && data.resourceType.size() <= 50 &&
             data.resourceId is string && data.resourceId.size() <= 128;
    }

    // Documents Collection
    match /documents/{documentId} {
      allow get: if isSignedIn() && isValidId(documentId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(documentId) && isValidDocumentRecord(incoming());
      allow update: if isSignedIn() && isValidId(documentId) && isValidDocumentRecord(incoming()) && (
        incoming().createdAt == existing().createdAt &&
        incoming().id == existing().id
      );
      allow delete: if isAdmin() && isValidId(documentId);
    }

    // Audit Logs Collection (Append-only immutable)
    match /auditLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming());
      allow update: if false; // Audit logs are immutable
      allow delete: if false; // Audit logs can never be deleted
    }
  }
}
