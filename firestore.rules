rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Companies Collection
    match /companies/{companyId} {
      allow read, write: if true;
    }

    // Departments Collection
    match /departments/{departmentId} {
      allow read, write: if true;
    }

    // Roles Collection (Module Access & Permissions)
    match /roles/{roleId} {
      allow read, write: if true;
    }

    // Users Collection (Accounts)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Numbering Rules Collection
    match /numberingRules/{ruleId} {
      allow read, write: if true;
    }

    // Form Templates Collection
    match /formTemplates/{templateId} {
      allow read, write: if true;
    }

    // Documents Collection
    match /documents/{documentId} {
      allow read, write: if true;
    }

    // Audit Logs Collection (Append-only immutable)
    match /auditLogs/{logId} {
      allow read, create: if true;
      allow update: if false; // Audit logs are immutable
      allow delete: if false; // Audit logs can never be deleted
    }
  }
}
