rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Documents Collection: Allow reading, writing, and updating documents
    match /documents/{documentId} {
      allow read, write: if true;
    }

    // Audit Logs Collection (Append-only immutable)
    match /auditLogs/{logId} {
      allow read, create: if true;
      allow update: if false; // Audit logs are immutable
      allow delete: if false; // Audit logs can never be deleted
    }
  }
}

